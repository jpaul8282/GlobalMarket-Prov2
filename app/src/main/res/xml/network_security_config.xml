<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Prevent Man-in-the-Middle (MITM) attacks by explicitly disabling cleartext HTTP traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

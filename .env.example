# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# STRIPE_PUBLISHABLE_KEY: Stripe Publishable Key (pk_test_... or pk_live_...) configured in AI Studio Secrets.
STRIPE_PUBLISHABLE_KEY=MY_STRIPE_PUBLISHABLE_KEY

# STRIPE_SECRET_KEY: Required for live Stripe Payouts API calls (sk_test_... or sk_live_... or rk_...).
# Configure this in the Secrets panel in AI Studio (never hardcode keys in source).
STRIPE_SECRET_KEY=MY_STRIPE_SECRET_KEY

# STRIPE_CONNECTED_ACCOUNT_ID: Optional Stripe Connect account ID (acct_...) for connected payouts.
STRIPE_CONNECTED_ACCOUNT_ID=MY_STRIPE_CONNECTED_ACCOUNT_ID

